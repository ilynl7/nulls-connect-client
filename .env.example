# Nulls Connect Explorer — environment variables
# Copy this file to .env and fill in values, or export the variables directly.
# The server reads these from the process environment; there is no dotenv loader.

# Port the web server listens on. Hosting providers usually inject this.
# Default: 3000
PORT=3000

# Override the Connect API base URL (default: https://connect.nulls.gg/api)
# Only needed when testing against a different backend.
# NC_API_UPSTREAM=https://connect.nulls.gg/api

# Override the Profiles API base URL (default: https://profiles.dnull.xyz)
# Only needed when testing against a different backend.
# NC_PROFILES_UPSTREAM=https://profiles.dnull.xyz
